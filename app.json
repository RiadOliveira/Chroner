{
  "expo": {
    "name": "Chroner",
    "slug": "Chroner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/base.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/base.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "android": {
      "package": "com.riadoliveira.Chroner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/foreground.png",
        "backgroundImage": "./assets/icons/background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "FunnelDisplay",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/FunnelDisplay-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "SpaceGrotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
