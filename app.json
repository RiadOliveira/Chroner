{
  "expo": {
    "name": "Chroner",
    "slug": "Chroner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.riadoliveira.Chroner"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ]
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "FunnelDisplay",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/FunnelDisplay-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/FunnelDisplay-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "SpaceGrotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
